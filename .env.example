# Optional overrides. `pag init` creates secrets in PAG_DATA_DIR instead.
PAG_DATA_DIR=.pag
PAG_HOST=127.0.0.1
PAG_PORT=8787
# PAG_MASTER_KEY=<base64-encoded 32 bytes>
# PAG_ADMIN_TOKEN=<strong random token>

# OAuth provider authentication (v1.2)
# For local development, register these callback URLs:
# GitHub: http://127.0.0.1:8787/oauth/callback/github
# Google: http://127.0.0.1:8787/oauth/callback/google
# PAG_PUBLIC_BASE_URL=https://pag.example.com
# PAG_OAUTH_FLOW_TTL_MINUTES=10
# PAG_OAUTH_GITHUB_CLIENT_ID=
# PAG_OAUTH_GITHUB_CLIENT_SECRET=
# PAG_OAUTH_GOOGLE_CLIENT_ID=
# PAG_OAUTH_GOOGLE_CLIENT_SECRET=
